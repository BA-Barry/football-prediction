# Repository contents: source, tests, research notes and a small saved run.
# Raw datasets, caches and large experiment artifacts stay outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/DATA_AND_ARTIFACTS.md
!/pyproject.toml
!/scripts/
!/docs/
!/model_v2/
!/work/
!/outputs/
!/data/

/model_v2/work/
/model_v2/*.egg-info/
/model_v2/build/
/model_v2/dist/
/*.egg-info/
**/*.egg-info/

!/scripts/**
!/docs/**

/work/*
!/work/*.py
!/work/*.ps1
!/work/*.md

/outputs/**
!/outputs/**/
!/outputs/**/*.md
!/outputs/**/*.txt
/outputs/**/upstream/
/outputs/**/GitHub原始证据/

# Complete, dated example with real probabilities and source provenance.
!/outputs/英超人员协作前瞻_20261029/*.json
!/outputs/英超人员协作前瞻_20261029/本次英超统计模型.joblib

/data/*
!/data/epl_adjusted_context_20261029/
/data/epl_adjusted_context_20261029/*
!/data/epl_adjusted_context_20261029/对手条件表现.json
!/data/epl_adjusted_context_20261029/逐场过去期待.json
!/data/epl_adjusted_context_20261029/方法与限制.md
!/data/epl_adjusted_context_20261029/models/

# Local environments, temporary output and authentication material.
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/node_modules/
**/*.pyc
**/*.pyo
**/.env
**/.env.*
!**/.env.example
**/credentials.json
**/*credentials*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/Thumbs.db
**/.DS_Store
